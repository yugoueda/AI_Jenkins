# Copy this file to .env. Do not commit .env.

# Image name used by Compose.
# For local build:
JENKINS_IMAGE=ai-jenkins:2.568.1-1
# For distribution, replace it with your registry:
# JENKINS_IMAGE=registry.example.com/your-team/ai-jenkins:2.568.1-1

# Keep 127.0.0.1 unless Jenkins must be directly reachable from the LAN.
# When exposing it, use a reverse proxy/TLS and set this to 0.0.0.0.
JENKINS_HTTP_HOST=127.0.0.1
JENKINS_HTTP_PORT=8080

# Optional JVM sizing. Adjust to the memory assigned to WSL/Docker.
JENKINS_JAVA_OPTS=-Xms512m -Xmx2g -Djenkins.install.runSetupWizard=true
