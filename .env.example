# Copy this file to .env. Do not commit .env.

# Image name used by Compose.
# For local build:
JENKINS_IMAGE=ai-jenkins:2.568.1-1
# For distribution, replace it with your registry:
# JENKINS_IMAGE=registry.example.com/your-team/ai-jenkins:2.568.1-1

# Keep 127.0.0.1 unless Jenkins must be directly reachable from the LAN.
# When exposing it, use a reverse proxy/TLS and set this to 0.0.0.0.
JENKINS_HTTP_HOST=127.0.0.1
JENKINS_HTTP_PORT=8080

# Optional JVM sizing. Adjust to the memory assigned to WSL/Docker.
JENKINS_JAVA_OPTS=-Xms512m -Xmx2g -Djenkins.install.runSetupWizard=true

# Webhook / CLI agent services (enabled with: docker compose --profile agent up)
AGENT_IMAGE=ai-agent:2.1.220-1
WEBHOOK_HTTP_HOST=127.0.0.1
WEBHOOK_HTTP_PORT=8000
GITLAB_WEBHOOK_SECRET=change-me

# Optional: a long-lived OAuth token generated by `claude setup-token`.
# The default Pro/Max setup uses `scripts/claude-login.sh login` instead and
# persists the interactive login in the claude-home Docker volume.
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic Console API billing is an optional alternative. API keys take
# precedence over subscription OAuth, so keep this empty when using Pro/Max.
# Set it only in .env and never commit the real value.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=sonnet
AGENT_TIMEOUT_SECONDS=600
AGENT_MAX_ATTEMPTS=2
